rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // User profile document: strictly isolated to the authenticated user
    match /users/{userId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    // Specific journal and reflection entries subcollection
    match /users/{userId}/entries/{entryId} {
      allow read, write, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
    // Subcollections: journal entries, checkins, reports, settings, and recursive documents
    match /users/{userId}/{document=**} {
      allow read, write, create, update, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
